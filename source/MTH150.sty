% Adjust the spacing below margin notes to remove indentation
\makeatletter
% Paragraph indentation and separation for normal text
\renewcommand{\@tufte@reset@par}{%
  \setlength{\RaggedRightParindent}{0.0pt}%
  \setlength{\JustifyingParindent}{0.0pt}%
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{1em}%
}
\@tufte@reset@par

\renewcommand\marginnote[2][0pt]{%
  \let\cite\@tufte@infootnote@cite%   use the in-sidenote \cite command
  \gdef\@tufte@citations{}%           clear out any old citations
  \@tufte@margin@par%                 use parindent and parskip settings for marginal text
  \marginpar{\hbox{}\vspace*{#1}\@tufte@marginnote@font\@tufte@marginnote@justification\vspace*{-1\baselineskip}\noindent #2\vspace*{\baselineskip}}%
  \@tufte@reset@par%                  use parindent and parskip settings for body text
  \@tufte@print@citations%            print any citations
  \let\cite\@tufte@normal@cite%       go back to using normal in-text \cite command
}

\makeatother


