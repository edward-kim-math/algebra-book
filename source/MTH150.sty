}

\newcounter{Classex}
\setcounter{Classex}{1}

\newenvironment{example}[1]{
  \begin{fullwidth}%
  \needspace{5\baselineskip}	% avoid splitting the heading line with example text
  {\bf Class Example \booksection.\theClassex} {\em #1} \vspace{-\parskip}
  \noindent\par
}{
  \stepcounter{Classex}
  \end{fullwidth}%
}

\newenvironment{exercises}{
  \begin{fullwidth}
  \emph{Suggested Exercises}
}{
  \end{fullwidth}
}

\newenvironment{bookexamples}[2]{  % chapter, counter
  \begin{enumerate}[{#1}.\arabic{enumi}]
    \setcounter{enumi}{#2}
    \addtocounter{enumi}{-1}
}{
  \end{enumerate}
}

\newcommand{\resetcounters}{ %
	\newpage
	\setcounter{Classex}{1}
	\setcounter{figure}{0}
	\setcounter{table}{0}
	\renewcommand{\thefigure}{\booksection.\arabic{figure}}
	\renewcommand{\thetable}{\booksection.\arabic{table}}
}
